{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "regions": ["bom1"],
  "buildCommand": "npm run build",
  "outputDirectory": ".cloud-dist",
  "functions": {
    "api/*.js": {
      "includeFiles": "{cloud/server/**,_template/rough-work-engine.js}",
      "excludeFiles": "{gate-cse-*/assets/**,**/*.pdf,**/attempt.json,tmp/**,tests/**}",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/_cloud/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/__/auth/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://gate-cse-practice.firebaseapp.com/__/auth/:path*"
    }
  ]
}
