# Public web config, available in Firebase project settings > Your apps.
FIREBASE_PROJECT_ID=gate-cse-practice
FIREBASE_WEB_CONFIG={"apiKey":"YOUR_PUBLIC_WEB_KEY","authDomain":"gate-cse-practice.firebaseapp.com","projectId":"gate-cse-practice","appId":"YOUR_WEB_APP_ID"}
# Production Safari/redirect support: use the stable Vercel hostname here,
# without https://, after it is assigned. This overrides authDomain above only.
# vercel.json transparently proxies /__/auth/* to gate-cse-practice.firebaseapp.com.
# Add the hostname in Firebase Authentication > Settings > Authorized domains.
# In Google Cloud > Google Auth Platform > Clients, add this OAuth redirect URI:
# https://YOUR_APP.vercel.app/__/auth/handler (keep existing Firebase URIs too).
FIREBASE_AUTH_DOMAIN=
# Keyless Vercel production identity; these identifiers are not private keys.
# Configure an OIDC pool/provider restricted to this project and production first.
GCP_PROJECT_NUMBER=719475848673
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
GCP_SERVICE_ACCOUNT_EMAIL=quiz-vercel@gate-cse-practice.iam.gserviceaccount.com
# Vercel disables CommonJS→ESM interop by default; Firebase Admin Auth needs it.
NODE_OPTIONS=--experimental-require-module
# Optional local/private-key alternative. Never commit a populated value.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Set to the exact production HTTPS origin after Vercel assigns it.
APP_ORIGIN=https://YOUR_APP.vercel.app
# Local cloud preview uses 8766 so the existing local server/state remains untouched.
CLOUD_PORT=8766
